{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run C++",
            "type": "shell",
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "cd /d ${fileDirname} && g++ ${file} -o ${fileBasenameNoExtension} && ${fileBasenameNoExtension}"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
